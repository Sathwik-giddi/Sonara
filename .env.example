# Copy to .env and fill in. Keys are created by YOU in each provider's console (all free):
# Groq:            https://console.groq.com  (API Keys)
# Google AI Studio: https://aistudio.google.com/apikey
# NVIDIA NIM:      https://build.nvidia.com  (nvapi- key, one-time trial credits)
# OpenRouter:      https://openrouter.ai/keys
GROQ_API_KEY=
GOOGLE_AI_STUDIO_KEY=
NVIDIA_NIM_KEY=
OPENROUTER_KEY=
MISTRAL_API_KEY=

# The router reads these names (see sonara/router.py KEY_VARS). A provider with
# no key is skipped, not an error - Sonara degrades to whatever tier it can reach.
# .env wins over any OS-level variable of the same name (load_dotenv override=True).
